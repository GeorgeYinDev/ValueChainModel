{
  "$schema": "../../../schema/scenario_simulation.schema.json",
  "scenario_id": "scenario_core_banking_liquidity_freeze",
  "name": "Core Banking Subledger & Fedwire Settlement Outage",
  "target_lifecycle": "L2S",
  "applicable_profiles": ["financial_services"],
  "description": "Simulates an intraday Core Banking Platform and Fedwire payment gateway degradation, halting automated commercial loan boarding, delaying wire principal disbursements, and forcing manual subledger-to-GL reconciliation.",
  "shocks": [
    {
      "target_element_id": "l2s_004_loan_booking_funding_disbursement",
      "attribute_modifier": "automation_rate",
      "multiplier": 0.25,
      "additive_delta": 0.0
    },
    {
      "target_element_id": "l2s_004_loan_booking_funding_disbursement",
      "attribute_modifier": "baseline_cycle_time_hours",
      "multiplier": 4.0,
      "additive_delta": 20.0
    },
    {
      "target_element_id": "l2s_006_delinquency_workout_ledger_settlement",
      "attribute_modifier": "baseline_cycle_time_hours",
      "multiplier": 2.5,
      "additive_delta": 18.0
    },
    {
      "target_element_id": "l2s_006_delinquency_workout_ledger_settlement",
      "attribute_modifier": "error_rate",
      "multiplier": 2.5,
      "additive_delta": 0.05
    }
  ]
}
