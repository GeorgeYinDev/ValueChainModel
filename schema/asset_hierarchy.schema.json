{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://valuechainmodel.schema/asset_hierarchy.json",
  "title": "AssetHierarchyNode",
  "type": "object",
  "required": [
    "id",
    "name",
    "asset_type",
    "version",
    "status"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "asset_type": {
      "type": "string",
      "enum": ["it_application", "erp_module", "database", "api_gateway", "financial_asset", "physical_facility"]
    },
    "version": { "type": "string" },
    "parent_asset_id": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["operational", "degraded", "outage", "maintenance"]
    },
    "sla_uptime_percent": { "type": "number" },
    "capacity_max_tps": { "type": "number" }
  }
}
